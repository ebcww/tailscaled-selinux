policy_module(tailscaled, 1.0.0)

########################################
#
# Declarations
#

type tailscaled_t;
type tailscaled_exec_t;
init_daemon_domain(tailscaled_t, tailscaled_exec_t)

permissive tailscaled_t;

type tailscaled_var_lib_t;
files_type(tailscaled_var_lib_t)

########################################
#
# tailscaled local policy
#
allow tailscaled_t self:capability { setgid setuid };
allow tailscaled_t self:fifo_file rw_fifo_file_perms;
allow tailscaled_t self:unix_stream_socket create_stream_socket_perms;

manage_dirs_pattern(tailscaled_t, tailscaled_var_lib_t, tailscaled_var_lib_t)
manage_files_pattern(tailscaled_t, tailscaled_var_lib_t, tailscaled_var_lib_t)
manage_lnk_files_pattern(tailscaled_t, tailscaled_var_lib_t, tailscaled_var_lib_t)
files_var_lib_filetrans(tailscaled_t, tailscaled_var_lib_t, { dir file lnk_file })

domain_use_interactive_fds(tailscaled_t)

files_read_etc_files(tailscaled_t)

auth_use_nsswitch(tailscaled_t)

miscfiles_read_localization(tailscaled_t)

sysnet_dns_name_resolve(tailscaled_t)

require {
	type systemd_oomd_t;
	type staff_t;
	type rpm_t;
	type virtlogd_t;
	type virtnetworkd_t;
	type system_cronjob_t;
	type staff_sudo_t;
	type systemd_userdbd_t;
	type irqbalance_t;
	type NetworkManager_dispatcher_t;
	type systemd_homed_t;
	type system_dbusd_t;
	type var_run_t;
	type policykit_t;
	type switcheroo_control_t;
	type staff_ssh_agent_t;
	type setroubleshootd_t;
	type virtstoraged_t;
	type virtnodedevd_t;
	type kernel_t;
	type systemd_resolved_t;
	type mcelog_t;
	type sysadm_t;
	type staff_dbusd_t;
	type xserver_t;
	type tailscaled_t;
	type unconfined_t;
	type unconfined_dbusd_t;
	type pcscd_t;
	class netlink_netfilter_socket { bind create getattr getopt setopt };
	class capability net_raw;
	class unix_dgram_socket { connect create getattr };
	class tun_socket create;
	class netlink_generic_socket { bind create getattr getopt setopt };
	class netlink_route_socket nlmsg_write;
	class tcp_socket { accept listen };
	class cap_userns sys_ptrace;
	class sock_file { create setattr unlink };
	class dir { open read search };
	class lnk_file read;
	class file { getattr open read };
}

