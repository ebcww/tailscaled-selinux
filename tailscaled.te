policy_module(tailscaled, 1.0.0)

########################################
#
# Declarations
#

type tailscaled_t;
type tailscaled_exec_t;
init_daemon_domain(tailscaled_t, tailscaled_exec_t)

permissive tailscaled_t;

type tailscaled_var_lib_t;
files_type(tailscaled_var_lib_t)

########################################
#
# tailscaled local policy
#
allow tailscaled_t self:capability { setgid setuid };
allow tailscaled_t self:fifo_file rw_fifo_file_perms;
allow tailscaled_t self:unix_stream_socket create_stream_socket_perms;

manage_dirs_pattern(tailscaled_t, tailscaled_var_lib_t, tailscaled_var_lib_t)
manage_files_pattern(tailscaled_t, tailscaled_var_lib_t, tailscaled_var_lib_t)
manage_lnk_files_pattern(tailscaled_t, tailscaled_var_lib_t, tailscaled_var_lib_t)
files_var_lib_filetrans(tailscaled_t, tailscaled_var_lib_t, { dir file lnk_file })

domain_use_interactive_fds(tailscaled_t)

files_read_etc_files(tailscaled_t)

auth_use_nsswitch(tailscaled_t)

miscfiles_read_localization(tailscaled_t)

sysnet_dns_name_resolve(tailscaled_t)

require {
	type systemd_oomd_t;
	type staff_t;
	type rpm_t;
	type virtlogd_t;
	type virtnetworkd_t;
	type system_cronjob_t;
	type staff_sudo_t;
	type systemd_userdbd_t;
	type irqbalance_t;
	type NetworkManager_dispatcher_t;
	type systemd_homed_t;
	type system_dbusd_t;
	type var_run_t;
	type policykit_t;
	type switcheroo_control_t;
	type staff_ssh_agent_t;
	type setroubleshootd_t;
	type virtstoraged_t;
	type virtnodedevd_t;
	type kernel_t;
	type systemd_resolved_t;
	type mcelog_t;
	type sysadm_t;
	type staff_dbusd_t;
	type xserver_t;
	type tailscaled_t;
	type unconfined_t;
	type unconfined_dbusd_t;
	type pcscd_t;
	class netlink_netfilter_socket { bind create getattr getopt setopt };
	class capability net_raw;
	class unix_dgram_socket { connect create getattr };
	class tun_socket create;
	class netlink_generic_socket { bind create getattr getopt setopt };
	class netlink_route_socket nlmsg_write;
	class tcp_socket { accept listen };
	class cap_userns sys_ptrace;
	class sock_file { create setattr unlink };
	class dir { open read search };
	class lnk_file read;
	class file { getattr open read };
}

#============= tailscaled_t ==============

#!!!! This avc is mandatory
allow tailscaled_t self:cap_userns sys_ptrace;

#!!!! This avc is allowed in the current policy
allow tailscaled_t self:capability net_raw;

#!!!! This avc is allowed in the current policy
allow tailscaled_t self:netlink_generic_socket { bind create getattr getopt setopt };

#!!!! This avc is allowed in the current policy
allow tailscaled_t self:netlink_netfilter_socket { bind create getattr getopt setopt };

#!!!! This avc is allowed in the current policy
allow tailscaled_t self:netlink_route_socket nlmsg_write;

#!!!! This avc is allowed in the current policy
allow tailscaled_t self:tcp_socket { accept listen };

#!!!! This avc is allowed in the current policy
allow tailscaled_t self:tun_socket create;

#!!!! This avc is allowed in the current policy
allow tailscaled_t self:unix_dgram_socket { connect create getattr };



#!!!! This avc is allowed in the current policy
allow tailscaled_t systemd_resolved_t:file read;

#!!!! This avc is allowed in the current policy
allow tailscaled_t systemd_resolved_t:lnk_file read;

#!!!! This avc is allowed in the current policy
allow tailscaled_t var_run_t:sock_file { create setattr unlink };

corenet_rw_tun_tap_dev(tailscaled_t)
corenet_tcp_connect_http_port(tailscaled_t)
files_manage_var_lib_files(tailscaled_t)
kernel_dgram_send(tailscaled_t)
kernel_read_network_state(tailscaled_t)
kernel_read_network_state_symlinks(tailscaled_t)
kernel_rw_net_sysctls(tailscaled_t)
kernel_search_network_sysctl(tailscaled_t)

require {
	type unconfined_t;
	type NetworkManager_dispatcher_t;
	type systemd_oomd_t;
	type systemd_resolved_t;
	type mcelog_t;
	type boltd_t;
	type systemd_userdbd_t;
	type staff_ssh_agent_t;
	type pcscd_t;
	type system_dbusd_t;
	type xserver_t;
	type systemd_machined_t;
	type kernel_t;
	type devicekit_disk_t;
	type staff_sudo_t;
	type irqbalance_t;
	type sysadm_t;
	type rpm_t;
	type abrt_dump_oops_t;
	type virtnetworkd_t;
	type virtnodedevd_t;
	type tailscaled_t;
	type staff_t;
	type switcheroo_control_t;
	type systemd_logind_t;
	type NetworkManager_dispatcher_chronyc_t;
	type virtlogd_t;
	type unconfined_dbusd_t;
	type virtstoraged_t;
	type staff_dbusd_t;
	type systemd_homed_t;
	type rtkit_daemon_t;
	type policykit_t;
	type setroubleshootd_t;
	type tuned_t;
	class dir { open read search };
	class lnk_file read;
	class file { getattr open read };
	class capability { dac_read_search sys_ptrace };
}

